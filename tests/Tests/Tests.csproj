<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <!-- xUnit v3 tests run as an executable. -->
        <OutputType>Exe</OutputType>
        <!-- Suppresses CA1707: Identifiers should not contain underscores -->
        <NoWarn>$(NoWarn);CA1707</NoWarn>
        <!-- Suppresses CA1861: Prefer 'static readonly' fields over constant array arguments -->
        <NoWarn>$(NoWarn);CA1861</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\src\Cli\Cli.csproj"/>
        <ProjectReference Include="..\..\src\Core\Core.csproj"/>
        <Using Include="Xunit"/>
        <PackageReference Include="xunit.v3.assert"/>
        <PackageReference Include="xunit.v3.core"/>
    </ItemGroup>
</Project>
